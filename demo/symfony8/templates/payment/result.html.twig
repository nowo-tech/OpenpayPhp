{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block nowo_ui_page_header %}
    {% set _toolbar %}<a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('home') }}">Back</a>{% endset %}
    {{ include(nowo_ui_partial('page_header'), {
        title: title,
        toolbar: _toolbar|trim,
    }) }}
{% endblock %}

{% block body %}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Response', kind: 'detail', testid: 'demo-result'} %}
        {% block section_body %}
            <pre class="nowo-ui-code-block" data-testid="demo-result-payload">{{ payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
        {% endblock %}
    {% endembed %}
{% endblock %}
