{% extends 'base.html.twig' %}

{% block title %}{{ title }}{% endblock %}

{% block nowo_ui_page_header %}
    <div class="nowo-ui-page-header">
        <h1 class="nowo-ui-page-header__title" data-testid="demo-result-title">{{ title }}</h1>
    </div>
{% endblock %}

{% block body %}
    <section class="nowo-ui-card">
        <div class="nowo-ui-card__body">
            <pre class="nowo-ui-code" data-testid="demo-result-payload">{{ payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
            <a class="nowo-ui-btn nowo-ui-btn--outline" href="{{ path('home') }}">Back</a>
        </div>
    </section>
{% endblock %}
