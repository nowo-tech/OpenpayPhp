    <h1>{{ title }}</h1>
    <pre style="background:#f4f4f5;padding:1rem;overflow:auto">{{ payload|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    <p><a href="{{ path('home') }}">Back</a></p>
  </main>
{% endblock %}
