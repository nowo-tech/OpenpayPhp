{% extends 'base.html.twig' %}

{% block title %}OpenpayPhp demo{% endblock %}

{% block nowo_ui_page_header %}
    {{ include(nowo_ui_partial('page_header'), {
        title: 'OpenpayPhp — Session demo',
        intro: 'Uses Nowo\\Openpay\\Session per request (FrankenPHP worker-safe).',
    }) }}
{% endblock %}

{% block body %}
    {# REQ-TWIG-005: Symfony Form Type (App\Form\CustomerType, a FormKit form) — never hand-written HTML form controls in demo Twig. #}
    {% embed '@NowoUiKit/demo_platform/_section.html.twig' with {title: 'Create customer', kind: 'form', testid: 'demo-customer-form'} %}
        {% block section_body %}
            {{ form_start(form, {attr: {id: 'customer-form', class: 'nowo-ui-form'}}) }}
                {% for child in form %}
                    {% if not child.rendered and child.vars.name != 'submit' %}
                        {{ form_row(child) }}
                    {% endif %}
                {% endfor %}
            {{ form_end(form, {render_rest: false}) }}
        {% endblock %}
        {% block section_footer %}
            <button type="submit" form="customer-form" class="nowo-ui-btn nowo-ui-btn--primary">{{ form.submit.vars.label }}</button>
        {% endblock %}
    {% endembed %}
{% endblock %}
