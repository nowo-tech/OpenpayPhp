{% extends 'base.html.twig' %}

{% block title %}OpenpayPhp demo{% endblock %}

{% block body %}
  <main style="max-width:40rem;margin:2rem auto;font-family:system-ui,sans-serif">
    <h1>OpenpayPhp — Session demo</h1>
    <p>Uses <code>Nowo\Openpay\Session</code> per request (FrankenPHP worker-safe). {% if usingMock %}No keys configured — responses are <strong>mocked</strong>.{% else %}Calling Openpay sandbox/live with your keys.{% endif %}</p>
    {# REQ-TWIG-005: Symfony Form Type (App\Form\CustomerType) — never hand-written HTML form controls in demo Twig. #}
    {{ form_start(form) }}
      {% for child in form %}
        {% if not child.rendered %}
          {{ form_row(child) }}
        {% endif %}
      {% endfor %}
      <button type="submit">Create customer</button>
    {{ form_end(form) }}
  </main>
{% endblock %}
