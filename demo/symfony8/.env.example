# Openpay PHP SDK demo (Symfony 8 + FrankenPHP)
# Copy to .env (`cp .env.example .env`); do not commit .env.

# PORT: host port mapped to the FrankenPHP container (docker-compose host:container).
PORT=8021

# APP_ENV: Symfony environment (dev/test/prod). The demo runs in `dev`.
APP_ENV=dev

# APP_DEBUG: enable detailed debug output and the Web Profiler (`1` in dev).
APP_DEBUG=1

# FRANKENPHP_MODE: `worker` (default, long-lived workers) or `classic` (one PHP execution per request).
# Recreate the containers (`make down && make up`) after changing it.
FRANKENPHP_MODE=worker

# APP_SECRET: secret used to sign CSRF tokens and cookies. Local-only value; never reuse in production.
APP_SECRET=change_this_secret_key_to_a_random_value

# DEFAULT_URI: base URL used for CLI URL generation (must match PORT).
DEFAULT_URI=http://localhost:8021

# Openpay merchant credentials. Leave both empty to use the mock HTTP transport in the demo UI.
# OPENPAY_MERCHANT_ID: merchant id from the Openpay dashboard.
OPENPAY_MERCHANT_ID=
# OPENPAY_PRIVATE_KEY: private API key (secret; never commit a real value).
OPENPAY_PRIVATE_KEY=
# OPENPAY_COUNTRY: API region — MX, CO or PE.
OPENPAY_COUNTRY=MX
# OPENPAY_SANDBOX: `1` uses the sandbox host, `0` the production host.
OPENPAY_SANDBOX=1
